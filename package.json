{
  "name": "openprime-app",
  "version": "1.26.11",
  "private": true,
  "dependencies": {
    "fflate": "^0.8.3",
    "keycloak-js": "^26.2.5",
    "lucide-react": "^0.575.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.2"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "catalog:parity": "node scripts/catalog-parity.js --catalog src/mocks/catalog.json",
    "catalog:lint": "node scripts/catalog-lint.js --catalog src/mocks/catalog.json",
    "catalog:check": "npm run catalog:parity && npm run catalog:lint",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "commit": "git-cz",
    "semantic-release": "semantic-release",
    "test:e2e": "node e2e/runner.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.6.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
