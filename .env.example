# OpenPrime Frontend — environment variables
# Read at build time via `import.meta.env`, or injected at runtime via
# `window._env_` in the container image. Copy to `.env` and fill in.
# Do NOT commit your real `.env`.

REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=openprime
REACT_APP_KEYCLOAK_CLIENT_ID=openprime-app
REACT_APP_API_URL=http://localhost:3001/api

# Feature flags — unset means off.
# Build the wizard from GET /api/catalog (extracted from the templates repo)
# instead of the static src/config/services/aws.js. Needs Injecto >= 0.10.0 and
# openprime-app-backend >= 1.15.0 running. If the catalog cannot be fetched the
# wizard falls back to the static config, so this is safe to toggle.
# In the container this is read from window._env_; the dev server and Vitest
# read VITE_USE_RUNTIME_CATALOG instead (see .env.mock).
REACT_APP_USE_RUNTIME_CATALOG=false
