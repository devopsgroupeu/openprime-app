# Enables FE mock mode (MSW + mock auth) — FE runs without backend/DB/Keycloak
VITE_MOCK=true

# Mock mode is the only place the runtime-catalog path can be exercised without
# a backend: MSW serves src/mocks/catalog.json, the same document Injecto
# extracts from the templates repo. Vitest does not read this file, so the
# static-config path stays covered by the test suite.
VITE_USE_RUNTIME_CATALOG=true
